# Copy this file to .env and fill it in. Never commit .env.
# The tax_math server needs no settings.

# LLM provider key. The team hasn't picked a provider yet: uncomment the one you use.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional LangSmith tracing, for run traces you can export to traces/.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
