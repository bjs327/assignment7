# Copy this file to .env and fill it in. Never commit .env.
# The tax_math server needs no settings.

# Anthropic API key: needed only to read new W-2 images (Document Extraction).
# Everything else runs without it using --offline. See README "API key".
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=          # only if you set EXTRACTION_PROVIDER=openai

# Document Extraction (W-2 images). Provider: anthropic (default) or openai.
# EXTRACTION_PROVIDER=anthropic
# EXTRACTION_MODEL=          # optional for anthropic (defaults to claude-sonnet-5-5); required for openai

# Optional LangSmith tracing, for run traces you can export to traces/.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
